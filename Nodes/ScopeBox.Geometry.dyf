  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "93707410ade94d25944b218daf92b08a",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "fb004cc6026f4a75842104fb197f6e10",
          "Name": "s",
          "Description": "s",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "7b5ff697813e4539b70bcefb9ab2103d",
          "Name": "c1",
          "Description": "c1 = s.Geometry()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "18529dc67dd1476b9d101a69576ca986",
          "Name": "msk",
          "Description": "msk = (Autodesk.DesignScript.Geometry.Vector.ZAxis().Dot(c1.Direction)) == 0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a76377d229e24a00ae0071a4c1bb320e",
          "Name": "c2",
          "Description": "c2 = DesignScript.Builtin.Get.ValueAtIndex(DSCore.List.FilterByBoolMask(c1, msk), \"in\")",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8f6040315d424f0f9777879bb4386cbf",
          "Name": "c3",
          "Description": "c3 = DSCore.List.SortByKey(c2, c2.EndPoint.Z)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "abfeaa0e810a4575a5053b0da8dd3a10",
          "Name": "c4",
          "Description": "c4 = DesignScript.Builtin.Get.ValueAtIndex(c3, \"sorted list\")",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "fe9be9007dc7452381ae9e98edcf7071",
          "Name": "c5",
          "Description": "c5 = ((c4 == null ? DesignScript.Builtin.Get.ValueAtIndex(c3, \"sortedList\") : c4))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bfe34ef7b3104dc28412f67122020a75",
          "Name": "pc1",
          "Description": "pc1 = Autodesk.DesignScript.Geometry.PolyCurve.ByJoinedCurves(DesignScript.Builtin.Get.ValueAtIndex(c5, 0..3))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "18f2c2fe141a424992d7a6142192eddb",
          "Name": "s1",
          "Description": "s1 = pc1.ExtrudeAsSolid((DesignScript.Builtin.Get.ValueAtIndex(c5, 4).EndPoint.Z) - (DesignScript.Builtin.Get.ValueAtIndex(c5, 0).EndPoint.Z))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "c1 = s.Geometry();\nmsk = Vector.ZAxis().Dot(c1.Direction) == 0;\nc2 = DSCore.List.FilterByBoolMask(c1, msk)[\"in\"];\nc3 = DSCore.List.SortByKey(c2, c2.EndPoint.Z);\nc4 = c3[\"sorted list\"];\nc5 = c4 == null ? c3[\"sortedList\"] : c4;\npc1 = Autodesk.DesignScript.Geometry.PolyCurve.ByJoinedCurves(c5[0..3]);\ns1 = pc1.ExtrudeAsSolid(c5[4].EndPoint.Z - c5[0].EndPoint.Z);"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Symbol, DynamoCore",
